{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_ASSISTANT_RESPONSES": "0",
    "OTEL_LOG_TOOL_DETAILS": "0",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_LOG_RAW_API_BODIES": "0",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://telemetry.googleapis.com",
    "OTEL_RESOURCE_ATTRIBUTES": "gcp.project_id=REPLACE_ME",
    "OTEL_METRICS_INCLUDE_ENTRYPOINT": "true"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが許可を求めています\" with title \"Claude Code\" subtitle \"確認待ち\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" subtitle \"処理終了\" sound name \"Hero\"'"
          },
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.plan // empty' | pbcopy"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MUXAC_SESSION_NAME\" ] && muxac hook || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clear-plan-skills@knwoop-clear-plan-skills": true,
    "telegram@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "adamsreview@adamsreview": true,
    "freee-mcp@freee-mcp-marketplace": true,
    "explainer@explainer": true,
    "see-it@see-it": true,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "knwoop-clear-plan-skills": {
      "source": {
        "source": "github",
        "repo": "knwoop/clear-plan-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "adamsreview": {
      "source": {
        "source": "github",
        "repo": "adamjgmiller/adamsreview"
      }
    },
    "freee-mcp-marketplace": {
      "source": {
        "source": "github",
        "repo": "freee/freee-mcp"
      }
    },
    "explainer": {
      "source": {
        "source": "github",
        "repo": "mizchi/explainer"
      }
    },
    "see-it": {
      "source": {
        "source": "github",
        "repo": "knwoop/see-it"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
