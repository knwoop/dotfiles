#!/bin/bash
# muxac session picker. Renders `muxac list --json` as colored,
# status-sorted rows in fzf with a tmux capture-pane preview.
#
# Usage:
#   muxac-pick           Attach to the selected session (exec muxac attach).
#   muxac-pick --print   Print "<name>\t<dir>" for the selected session and exit.

set -eu

mode="attach"
if [ "${1:-}" = "--print" ]; then
    mode="print"
fi

json="$(muxac list --json 2>/dev/null || true)"
[ -z "$json" ] && exit 0

rows="$(printf '%s' "$json" | jq -r '
    def prio:
        if . == "waiting" then 0
        elif . == "running" then 1
        elif . == "idle"    then 2
        else 3 end;
    .sessions
    | sort_by((.status | prio), .name)
    | .[]
    | [.status, .name, .directory] | @tsv
')"
[ -z "$rows" ] && exit 0

colored="$(printf '%s\n' "$rows" | awk -F'\t' '
{
    reset = "\033[0m";
    if      ($1 == "waiting") c = "\033[33m";
    else if ($1 == "running") c = "\033[32m";
    else if ($1 == "idle")    c = "\033[90m";
    else                      c = "\033[31m";
    printf "%s%-8s%s\t%s\t%s\n", c, $1, reset, $2, $3;
}')"

selected="$(printf '%s\n' "$colored" \
    | fzf --ansi \
          --delimiter=$'\t' \
          --with-nth=1,2,3 \
          --preview 'tmux capture-pane -ept {2} -p 2>/dev/null | tail -n 80' \
          --preview-window=right:60%)" || exit 0

[ -z "$selected" ] && exit 0

name="$(printf '%s' "$selected" | awk -F'\t' '{print $2}')"
dir="$(printf '%s' "$selected" | awk -F'\t' '{print $3}')"

if [ "$mode" = "print" ]; then
    printf '%s\t%s\n' "$name" "$dir"
    exit 0
fi

exec muxac attach --name "$name" --dir "$dir"
